# Secrets — never commit
.env
.env.*
*.key
*.pem

# Private data (portfolio, holdings, audit trails, cached responses).
# Deliberately UNANCHORED (no leading path): a pattern containing a slash only
# matches that one location, so `reference/portfolio-holdings.md` did nothing
# to stop a copy landing in the repo root or docs/. These match at any depth.
data/
portfolio-holdings.md
rsu-schedule.md
accounts.md
watchlist.md
etf-classifications.md
predictions.jsonl
snapshots.jsonl
*.jsonl.bak
fr_raw_*.json
fr_brief_*.md
fr_digest_*.md
eod_*.md

# Generated reports and analysis output
reports/
*-fr.md
*-eod.md

# Build artifacts
graphify-out/
npm-cache/
dist/
build/
*.egg-info/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# OS / editor
.DS_Store
.idea/
.vscode/
