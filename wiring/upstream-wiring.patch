+# 13F institutional holdings
+# ---------------------------------------------------------------------------
+
+# Curated CIKs for well-known 13F filers — "who holds ticker X" requires
+# scanning every 13F filer, which isn't feasible via the free API.
+_INSTITUTION_CIKS: dict[str, str] = {
+    "berkshire": "0001067983",
+    "bridgewater": "0001350694",
+    "scion": "0001649339",
+    "ark": "0001697748",
+    "pershing_square": "0001336528",
+}
+
+_THIRTEENF_NS = {"ns": "http://www.sec.gov/edgar/document/thirteenf/informationtable"}
