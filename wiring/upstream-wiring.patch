+async def web_search(query: str, count: int = 5) -> dict:
+    """Search the web: Brave when configured, DuckDuckGo otherwise or on failure.
+
+    Args:
+        query: Search query string.
+        count: Number of results to return (default 5, max 20).
+
+    Returns:
+        Dict with search results (title, url, description) — or an error dict
+        if every provider failed.
+    """
+    count = min(count, _MAX_RESULTS)
+    cache_key = f"web_search_{query}_{count}"
+    cached = cache.get(cache_key)
+    if cached:
+        log.debug("Cache hit: %s", cache_key)
+        return cached
+
+    result: dict | None = None
+    if BRAVE_API_KEY:
+        result = await _brave_search(query, count)
+        if "error" in result:
+            log.warning("Brave Search unavailable (%s) — falling back to DuckDuckGo", result["error"])
+            result = None
+
+    if result is None:
+        result = await _ddg_search(query, count)
+        if "error" in result:
+            return result
+
