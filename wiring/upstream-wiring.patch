+def _parse_formatted_number(text: str | float | None) -> float | None:
+    """Parse a display-formatted number like '$220,000,000' into a float."""
+    if text is None:
+        return None
+    if isinstance(text, (int, float)):
+        return float(text)
+    cleaned = text.replace("$", "").replace(",", "").strip()
+    try:
+        return float(cleaned)
+    except ValueError:
+        return None
