+            signal = "no data"
+        elif avg_funding > CRYPTO_FUNDING_CROWDED_LONG:
+            signal = f"crowded LONG — longs paying {avg_funding:.4f}%/8h, short squeeze risk"
+        elif avg_funding < CRYPTO_FUNDING_CROWDED_SHORT:
+            signal = f"crowded SHORT — shorts paying {abs(avg_funding):.4f}%/8h, long squeeze risk"
+        elif avg_funding > 0:
+            signal = "mild bullish bias"
+        else:
+            signal = "mild bearish bias"
+        results[coin] = {
+            "avg_funding_rate_8h_pct": avg_funding,
+            "avg_funding_annualized_pct": round(avg_funding * 3 * 365, 2) if avg_funding else None,
+            "total_open_interest_usd": total_oi,
+            "exchanges_tracked": len(rates),
+            "signal": signal,
