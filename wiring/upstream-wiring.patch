+def _aggregate_derivatives(coin_data: dict[str, dict]) -> dict[str, dict]:
+    """Average funding and total open interest per coin, with a positioning
+    signal. Funding is in percent per 8h (0.01 = 0.01%/8h)."""
+    results = {}
+    for coin, cd in coin_data.items():
+        rates = cd["funding_rates"]
+        ois = cd["open_interests"]
+        avg_funding = round(sum(rates) / len(rates), 6) if rates else None
+        total_oi = round(sum(ois), 0) if ois else None
