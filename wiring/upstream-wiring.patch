+# ---------------------------------------------------------------------------
+# Insider transactions (Form 4)
+# ---------------------------------------------------------------------------
+
+# Form 4 transactionAcquiredDisposedCode -> direction
+_TXN_CODE_DIRECTION = {"A": "buy", "D": "sell"}
+
+
+def _parse_form4(xml_text: str) -> list[dict]:
+    """Parse non-derivative transactions out of a Form 4 XML document."""
+    root = ET.fromstring(xml_text)
+
+    owner_name = ""
+    owner_title = ""
+    owner_id = root.find("reportingOwner/reportingOwnerId")
+    if owner_id is not None:
+        name_el = owner_id.find("rptOwnerName")
+        if name_el is not None and name_el.text:
+            owner_name = name_el.text
+    relationship = root.find("reportingOwner/reportingOwnerRelationship")
+    if relationship is not None:
+        title_el = relationship.find("officerTitle")
+        if title_el is not None and title_el.text:
+            owner_title = title_el.text
+
+    transactions: list[dict] = []
+    table = root.find("nonDerivativeTable")
+    if table is None:
+        return transactions
+
+    for txn in table.findall("nonDerivativeTransaction"):
+        date_el = txn.find("transactionDate/value")
+        shares_el = txn.find("transactionAmounts/transactionShares/value")
+        if date_el is None or date_el.text is None or shares_el is None or shares_el.text is None:
+            continue
+
+        price_el = txn.find("transactionAmounts/transactionPricePerShare/value")
+        code_el = txn.find("transactionAmounts/transactionAcquiredDisposedCode/value")
+
+        shares = float(shares_el.text)
+        price = float(price_el.text) if price_el is not None and price_el.text else 0.0
+        code = code_el.text if code_el is not None and code_el.text else ""
+
+        transactions.append(
+            {
+                "date": date_el.text,
+                "owner": owner_name,
+                "title": owner_title,
+                "transaction_type": _TXN_CODE_DIRECTION.get(code, code),
+                "shares": shares,
+                "price": price,
+                "value": round(shares * price, 2),
+            }
+        )
+    return transactions
+
+
+async def get_insider_transactions(symbol: str, limit: int = 10) -> dict:
+    """Fetch recent SEC Form 4 insider transactions (buys/sells by executives/directors).
+
+    Parameters
+    ----------
+    symbol:
+        Stock ticker.
+    limit:
+        Max number of Form 4 filings to fetch and parse.
+    """
+    symbol = symbol.upper()
+    cache_key = f"edgar_insider_{symbol}_{limit}"
+    cached = cache.get(cache_key)
+    if cached:
+        log.debug("Cache hit: %s", cache_key)
+        return cached
+
+    try:
+        cik = await _resolve_cik(symbol)
+    except (ValueError, httpx.HTTPError) as exc:
+        return _error(symbol, str(exc))
+
+    url = f"https://data.sec.gov/submissions/CIK{cik}.json"
+    try:
+        async with httpx.AsyncClient() as client:
+            resp = await _rate_limited_get(client, url)
+            resp.raise_for_status()
+            data = resp.json()
+    except httpx.HTTPStatusError as exc:
+        log.warning("EDGAR HTTP %d for %s", exc.response.status_code, url)
+        return _error(symbol, f"HTTP {exc.response.status_code}")
+    except (httpx.TimeoutException, httpx.ConnectError) as exc:
+        log.error("EDGAR connection error: %s", exc)
+        return _error(symbol, "Connection to SEC EDGAR failed")
+
+    company_name = data.get("name", "")
+    recent = data.get("filings", {}).get("recent", {})
+    forms = recent.get("form", [])
+    accession_numbers = recent.get("accessionNumber", [])
+    primary_docs = recent.get("primaryDocument", [])
+
+    form4_docs: list[tuple[str, str]] = []
+    for i, form in enumerate(forms):
+        if form != "4":
+            continue
+        accession = accession_numbers[i] if i < len(accession_numbers) else ""
+        primary_doc = primary_docs[i] if i < len(primary_docs) else ""
+        if accession and primary_doc:
+            form4_docs.append((accession, primary_doc))
+        if len(form4_docs) >= limit:
+            break
+
+    transactions: list[dict] = []
+    async with httpx.AsyncClient() as client:
+        for accession, primary_doc in form4_docs:
+            accession_path = accession.replace("-", "")
+            # primaryDocument often points at the XSLT-rendered HTML view
+            # (e.g. "xslF345X06/form4.xml"); the raw ownership XML lives
+            # under the same filename at the accession root.
+            doc_filename = primary_doc.rsplit("/", 1)[-1]
+            doc_url = f"https://www.sec.gov/Archives/edgar/data/{int(cik)}/{accession_path}/{doc_filename}"
+            try:
+                resp = await _rate_limited_get(client, doc_url)
+                resp.raise_for_status()
+                transactions.extend(_parse_form4(resp.text))
+            except (httpx.HTTPError, ET.ParseError) as exc:
+                log.warning("Skipping unparseable Form 4 %s: %s", doc_url, exc)
+                continue
+
+    total_buy_shares = total_sell_shares = 0.0
+    total_buy_value = total_sell_value = 0.0
+    for txn in transactions:
+        if txn["transaction_type"] == "buy":
+            total_buy_shares += txn["shares"]
+            total_buy_value += txn["value"]
+        elif txn["transaction_type"] == "sell":
+            total_sell_shares += txn["shares"]
+            total_sell_value += txn["value"]
+
+    result = {
+        "symbol": symbol,
+        "company_name": company_name,
+        "transactions": transactions,
+        "summary": {
+            "total_buys": total_buy_shares,
+            "total_sells": total_sell_shares,
+            "net_shares": total_buy_shares - total_sell_shares,
+            "net_value": round(total_buy_value - total_sell_value, 2),
+        },
+        "source": "sec_edgar",
+    }
+    cache.set(cache_key, result, CACHE_TTL_FILINGS)
+    return result
