+def _parse_coingecko_derivatives(data: list) -> dict[str, dict]:
+    """Reduce CoinGecko's flat ``/derivatives`` ticker list to per-coin funding
+    and open-interest series for the focus symbols."""
+    coin_data: dict[str, dict] = {}
+    for ticker in data:
+        index_id = (ticker.get("index_id") or "").upper()
+        if index_id not in _DERIVATIVES_FOCUS or (ticker.get("contract_type") or "").lower() != "perpetual":
+            continue
+        entry = coin_data.setdefault(index_id, {"funding_rates": [], "open_interests": []})
+        funding = ticker.get("funding_rate")
+        oi = ticker.get("open_interest")
+        if funding is not None:
+            entry["funding_rates"].append(float(funding))
+        if oi is not None:
+            try:
+                entry["open_interests"].append(float(oi))
+            except (TypeError, ValueError):
+                pass
+    return coin_data
+
