+async def _dominance_from_coinpaprika() -> dict:
+    """Keyless CoinPaprika fallback for dominance when CoinGecko is rate-limited (429).
+
+    CoinPaprika (api.coinpaprika.com, no key) exposes btc dominance + total market
+    cap via /global and per-coin market caps + 30d change via /tickers, which is
+    enough to reconstruct btc/eth/stablecoin dominance and the altcoin-season read.
+    """
+    try:
+        async with httpx.AsyncClient() as client:
+            glob_resp, tick_resp = await asyncio.gather(
+                client.get(f"{_COINPAPRIKA_BASE}/global", timeout=10),
+                client.get(f"{_COINPAPRIKA_BASE}/tickers", params={"limit": 25}, timeout=10),
+            )
+            glob_resp.raise_for_status()
+            tick_resp.raise_for_status()
+            glob = glob_resp.json()
+            tickers = tick_resp.json()
+    except (httpx.HTTPError, ValueError) as e:
+        log.warning("CoinPaprika dominance fallback failed: %s", e)
+        return {"error": "HTTP 429 (CoinGecko) — CoinPaprika fallback also unavailable", "source": "coingecko+coinpaprika"}
+
+    total_mcap = glob.get("market_cap_usd") or 0
+    btc_dom = round(glob.get("bitcoin_dominance_percentage", 0), 2)
+
+    eth_dom = 0.0
+    stable_mcap = 0.0
+    btc_30d = None
+    altcoin_beats = 0
+    altcoin_total = 0
+    if isinstance(tickers, list) and total_mcap > 0:
+        for c in tickers:
+            sym = (c.get("symbol") or "").upper()
+            usd = c.get("quotes", {}).get("USD", {})
+            mcap = usd.get("market_cap") or 0
+            chg = usd.get("percent_change_30d")
+            if sym == "BTC":
+                btc_30d = chg
+            elif sym == "ETH":
+                eth_dom = round(mcap / total_mcap * 100, 2)
+            elif sym in _STABLE_SYMBOLS:
+                stable_mcap += mcap
+            if sym not in _STABLE_SYMBOLS and sym != "BTC" and chg is not None:
+                altcoin_total += 1
+                if btc_30d is not None and chg > btc_30d:
+                    altcoin_beats += 1
+    stable_dom = round(stable_mcap / total_mcap * 100, 2) if total_mcap > 0 else 0.0
+
+    result = _build_dominance(
+        btc_dom, eth_dom, stable_dom, altcoin_beats, altcoin_total, btc_30d,
+        "coinpaprika (fallback — CoinGecko rate-limited)",
+    )
+    cache.set("coingecko_dominance", result, CACHE_TTL_CRYPTO_OVERVIEW)
+    return result
