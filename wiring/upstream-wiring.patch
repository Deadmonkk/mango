+        if isinstance(markets, list):
+            prices_data = {m["id"]: m for m in markets}
+
+    results = []
+    for coin in coins:
+        item = coin.get("item", {})
+        cid = item.get("id", "")
+        p = prices_data.get(cid, {})
+        # The trending payload itself embeds price data — use it whenever the
+        # secondary markets call failed (e.g. 429) instead of blanking fields.
+        embedded = item.get("data") or {}
+        price = p.get("current_price")
+        if price is None:
+            price = embedded.get("price")
+        change_24h = p.get("price_change_percentage_24h")
+        if change_24h is None:
+            change_24h = (embedded.get("price_change_percentage_24h") or {}).get("usd")
+        market_cap = p.get("market_cap")
+        if market_cap is None:
+            market_cap = _parse_formatted_number(embedded.get("market_cap"))
+        results.append(
+            {
+                "name": item.get("name"),
+                "symbol": (item.get("symbol") or "").upper(),
+                "market_cap_rank": item.get("market_cap_rank"),
+                "price_usd": price,
+                "change_24h_pct": change_24h,
+                "change_7d_pct": p.get("price_change_percentage_7d_in_currency"),
+                "market_cap_usd": market_cap,
+            }
+        )
+
+    out = {
+        "trending_coins": results,
+        "note": "Most searched on CoinGecko in last 24h. Trending coins often move 24-48h after appearing here.",
+        "source": "coingecko",
+    }
+    cache.set(cache_key, out, CACHE_TTL_CRYPTO_TRENDING)
+    return out
