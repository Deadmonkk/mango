+                  artificial-intelligence, gaming, layer-2). Empty = all.
+        min_market_cap_b: Minimum market cap in billions USD (0 = no minimum).
+        max_market_cap_b: Maximum market cap in billions USD (0 = no maximum).
+        sort_by: Sort order — market_cap_desc, volume_desc, price_change_24h_desc,
+                 price_change_24h_asc.
+        limit: Maximum results (default 20, max 50).
+    """
+    cache_key = f"coingecko_screen_{category}_{min_market_cap_b}_{max_market_cap_b}_{sort_by}_{limit}"
+    cached = cache.get(cache_key)
+    if cached:
+        return cached
+
+    params: dict = {
+        "vs_currency": "usd",
+        "order": sort_by,
+        "per_page": min(max(limit, 1), 50),
+        "page": 1,
+        "price_change_percentage": "24h,7d,30d",
+        "sparkline": "false",
+    }
+    if category:
+        params["category"] = category
+
+    async with httpx.AsyncClient() as client:
+        data = await _fetch(client, f"{BASE_URL}/coins/markets", params)
+
+    if isinstance(data, dict) and "_error" in data:
+        return {"error": data["_error"], "source": "coingecko"}
+    if not isinstance(data, list):
+        return {"error": "Unexpected response", "source": "coingecko"}
+
+    min_mc = min_market_cap_b * 1e9 if min_market_cap_b > 0 else 0
+    max_mc = max_market_cap_b * 1e9 if max_market_cap_b > 0 else float("inf")
+
+    results = [
+        {
+            "symbol": (c.get("symbol") or "").upper(),
+            "name": c.get("name"),
+            "rank": c.get("market_cap_rank"),
