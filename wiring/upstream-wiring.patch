+    if isinstance(trending_data, dict) and "_error" in trending_data:
+        return {"error": trending_data["_error"], "source": "coingecko"}
+
+    coins = trending_data.get("coins", [])
+    coin_ids = [c["item"]["id"] for c in coins if "item" in c]
+
+    prices_data: dict = {}
+    if coin_ids:
+        async with httpx.AsyncClient() as client:
+            markets = await _fetch(
+                client,
+                f"{BASE_URL}/coins/markets",
+                {
