+        log.info("CoinGecko derivatives failed — served Hyperliquid single-venue fallback")
+        source = "hyperliquid (fallback — CoinGecko unavailable)"
+        note += " NOTE: fallback data is from Hyperliquid only (single venue), not a multi-exchange average."
+    elif not isinstance(data, list):
