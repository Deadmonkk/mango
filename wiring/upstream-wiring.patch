+
+async def get_13f_holdings(institution: str, limit: int = 20) -> dict:
+    """Fetch the latest 13F top holdings for a tracked institution.
+
+    Parameters
+    ----------
+    institution:
+        One of: berkshire, bridgewater, scion, ark, pershing_square.
+    limit:
+        Max number of holdings to return, sorted by value descending.
+    """
+    institution_key = institution.lower()
+    cik = _INSTITUTION_CIKS.get(institution_key)
+    if cik is None:
+        return _13f_error(f"Unknown institution '{institution}'. Valid options: {', '.join(sorted(_INSTITUTION_CIKS))}")
+
+    cache_key = f"edgar_13f_{institution_key}_{limit}"
+    cached = cache.get(cache_key)
+    if cached:
+        log.debug("Cache hit: %s", cache_key)
+        return cached
+
+    submissions_url = f"https://data.sec.gov/submissions/CIK{cik}.json"
+    try:
+        async with httpx.AsyncClient() as client:
+            resp = await _rate_limited_get(client, submissions_url)
+            resp.raise_for_status()
+            data = resp.json()
+    except httpx.HTTPStatusError as exc:
+        log.warning("EDGAR HTTP %d for %s", exc.response.status_code, submissions_url)
+        return _13f_error(f"HTTP {exc.response.status_code}")
+    except (httpx.TimeoutException, httpx.ConnectError) as exc:
+        log.error("EDGAR connection error: %s", exc)
+        return _13f_error("Connection to SEC EDGAR failed")
+
+    institution_name = data.get("name", "")
+    recent = data.get("filings", {}).get("recent", {})
+    forms = recent.get("form", [])
+    accession_numbers = recent.get("accessionNumber", [])
+    filing_dates = recent.get("filingDate", [])
+
+    accession = None
+    report_date = None
+    for i, form in enumerate(forms):
+        if form == "13F-HR":
+            accession = accession_numbers[i] if i < len(accession_numbers) else None
+            report_date = filing_dates[i] if i < len(filing_dates) else None
+            break
+
+    if accession is None:
+        return _13f_error(f"No 13F-HR filing found for {institution_key}")
+
+    accession_path = accession.replace("-", "")
+    index_url = f"https://www.sec.gov/Archives/edgar/data/{int(cik)}/{accession_path}/index.json"
+    try:
+        async with httpx.AsyncClient() as client:
+            resp = await _rate_limited_get(client, index_url)
+            resp.raise_for_status()
+            index_data = resp.json()
+    except httpx.HTTPStatusError as exc:
+        log.warning("EDGAR HTTP %d for %s", exc.response.status_code, index_url)
+        return _13f_error(f"HTTP {exc.response.status_code}")
+    except (httpx.TimeoutException, httpx.ConnectError) as exc:
+        log.error("EDGAR connection error: %s", exc)
+        return _13f_error("Connection to SEC EDGAR failed")
+
+    info_table_name = None
+    for item in index_data.get("directory", {}).get("item", []):
+        name = item.get("name", "")
+        if re.fullmatch(r"\d+\.xml", name):
+            info_table_name = name
+            break
+
+    if info_table_name is None:
+        return _13f_error(f"Could not locate 13F information table for {institution_key}")
+
+    table_url = f"https://www.sec.gov/Archives/edgar/data/{int(cik)}/{accession_path}/{info_table_name}"
+    try:
+        async with httpx.AsyncClient() as client:
+            resp = await _rate_limited_get(client, table_url)
+            resp.raise_for_status()
+            xml_text = resp.text
+    except httpx.HTTPStatusError as exc:
+        log.warning("EDGAR HTTP %d for %s", exc.response.status_code, table_url)
+        return _13f_error(f"HTTP {exc.response.status_code}")
+    except (httpx.TimeoutException, httpx.ConnectError) as exc:
+        log.error("EDGAR connection error: %s", exc)
+        return _13f_error("Connection to SEC EDGAR failed")
+
+    try:
+        root = ET.fromstring(xml_text)
+    except ET.ParseError as exc:
+        log.error("Failed to parse 13F information table: %s", exc)
+        return _13f_error("Failed to parse 13F information table")
+
+    holdings: list[dict] = []
+    for entry in root.findall("ns:infoTable", _THIRTEENF_NS):
+        issuer_el = entry.find("ns:nameOfIssuer", _THIRTEENF_NS)
+        cusip_el = entry.find("ns:cusip", _THIRTEENF_NS)
+        value_el = entry.find("ns:value", _THIRTEENF_NS)
+        shares_el = entry.find("ns:shrsOrPrnAmt/ns:sshPrnamt", _THIRTEENF_NS)
+        if issuer_el is None or issuer_el.text is None or value_el is None or value_el.text is None:
+            continue
+        holdings.append(
+            {
+                "issuer": issuer_el.text,
+                "cusip": cusip_el.text if cusip_el is not None else "",
+                "value_thousands_usd": int(value_el.text),
+                "shares": int(shares_el.text) if shares_el is not None and shares_el.text else 0,
+            }
+        )
+
+    holdings.sort(key=lambda h: h["value_thousands_usd"], reverse=True)
+    total_value = sum(h["value_thousands_usd"] for h in holdings)
+    top_holdings = holdings[:limit]
+    for h in top_holdings:
+        h["pct_of_portfolio"] = round(h["value_thousands_usd"] / total_value * 100, 2) if total_value else 0.0
+
+    result = {
+        "institution": institution_key,
+        "institution_name": institution_name,
+        "cik": cik,
+        "report_date": report_date,
+        "holdings": top_holdings,
+        "total_value_thousands_usd": total_value,
+        "total_positions": len(holdings),
+        "source": "sec_edgar",
+    }
+    cache.set(cache_key, result, CACHE_TTL_FILINGS)
+    return result
